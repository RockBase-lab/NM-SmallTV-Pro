{
  "spec": 2,
  "theme": {
    "id": "classic-24",
    "name": "Classic 24",
    "author": "SmallTV",
    "version": "1.0.0"
  },
  "display": {
    "width": 240,
    "height": 240,
    "background": "#000000"
  },
  "layers": [
    {
      "id": "time",
      "type": "text",
      "x": 120,
