      "size": 48,
      "color": "#ffffff"
    },
    {
      "id": "date",
      "type": "text",
      "x": 120,
      "y": 145,
      "anchor": "center",
      "value": "{YYYY}/{MO}/{DD}",
      "size": 16,
      "color": "#00c8c8"
    }
  ]
}
